# Runtime
NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:8787
DATABASE_PATH=./data/journal.db
UPLOAD_DIR=./uploads

# Initial owner account. Required for first boot in a fresh database.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional profile defaults used only while seeding a fresh database.
OWNER_NAME=Abhinav
OWNER_HANDLE=Abhinavlearns

# Azure SQL Database. Leave these blank to keep the local SQLite file.
# Allow your IP on the server Networking page before starting the app.
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
